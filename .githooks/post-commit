#!/bin/sh
# Push main in the background so every surface (Claude Code, claude.ai, Cowork) can pull it.
# Read .git/last-push.log if `git status -sb` ever shows "ahead".
cd "$(git rev-parse --show-toplevel)" || exit 0
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
( git push -q origin main > .git/last-push.log 2>&1 && date '+pushed %Y-%m-%d %H:%M:%S' >> .git/last-push.log ) &
exit 0
