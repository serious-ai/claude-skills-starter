#!/bin/sh
# Bump the patch version of every plugin whose files changed in this commit.
# Claude Code, claude.ai and Cowork only pull an update when the version moves, so this is
# a check rather than a rule to remember. Then validate the marketplace and each plugin.
cd "$(git rev-parse --show-toplevel)" || exit 0
for PLUG in $(git diff --cached --name-only | sed -n 's#^plugins/\([^/]*\)/.*#\1#p' | sort -u); do
  PJ="plugins/$PLUG/.claude-plugin/plugin.json"
  [ -f "$PJ" ] || continue
  # Skip only when this commit already moved the version by hand. Compare with the last committed
  # copy at the same path: a renamed or brand-new plugin.json has none, so it still gets its bump.
  OLD=$(git show "HEAD:$PJ" 2>/dev/null | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' | head -1)
  NEW=$(git show ":$PJ" 2>/dev/null | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' | head -1)
  [ -n "$OLD" ] && [ "$OLD" != "$NEW" ] && continue
  python3 - "$PJ" <<'PY'
import json, sys
p = sys.argv[1]; d = json.load(open(p))
a, b, c = (int(x) for x in d["version"].split("."))
d["version"] = f"{a}.{b}.{c + 1}"
open(p, "w").write(json.dumps(d, indent=2) + "\n")
print(f"{d['name']} plugin version -> {d['version']}")
PY
  git add "$PJ"
done
if command -v claude >/dev/null 2>&1; then
  for T in . plugins/*; do
    claude plugin validate "$T" >/tmp/claude-skills-validate.log 2>&1 || { cat /tmp/claude-skills-validate.log; echo "Validation failed for $T, commit stopped."; exit 1; }
  done
fi
# A hook change runs its plugin's hook tests before it can land, because the post-commit merges
# straight to main and every surface picks it up (Anthropic code review webinar, November 2026:
# verify before anyone looks). A failure stops the commit, and the Stop hook's auto-sync then
# leaves the change uncommitted for the next turn to fix.
for HD in $(git diff --cached --name-only | sed -n 's#^\(plugins/[^/]*/hooks\)/.*#\1#p' | sort -u); do
  for T in "$HD"/test_*.py; do
    [ -f "$T" ] || continue
    python3 -I "$T" >/tmp/claude-skills-hooktest.log 2>&1 || {
      tail -20 /tmp/claude-skills-hooktest.log; echo "Hook test failed: $T, commit stopped."
      osascript -e "display notification \"Hook test failed: $(basename "$T"). Change left uncommitted.\" with title \"claude-skills\"" 2>/dev/null
      exit 1; }
  done
done
# If this repo keeps a public twin, say when a commit changes a file the twin should also get.
# A warning, never a block: unattended auto-sync commits must still land.
[ -f scripts/template-drift.py ] && python3 scripts/template-drift.py --staged
# A dollar sign before a digit in a SKILL.md ("$5M") can load as an argument placeholder ($0, $1, ...)
# and swap the number out when the skill runs. Warn on newly added lines only.
HITS=$(git diff --cached -U0 -- '*SKILL.md' | grep -E '^\+[^+].*\$[0-9]')
[ -n "$HITS" ] && printf 'Warning: "$" before a digit in staged SKILL.md lines (write "5M USD" or "5,000 dollars"):\n%s\n' "$HITS"
exit 0
