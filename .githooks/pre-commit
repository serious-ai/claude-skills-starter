#!/bin/sh
# Bump the patch version of every plugin whose files changed in this commit.
# Claude Code, claude.ai and Cowork only pull an update when the version moves, so this is
# a check rather than a rule to remember. Then validate the marketplace and each plugin.
cd "$(git rev-parse --show-toplevel)" || exit 0
for PLUG in $(git diff --cached --name-only | sed -n 's#^plugins/\([^/]*\)/.*#\1#p' | sort -u); do
  PJ="plugins/$PLUG/.claude-plugin/plugin.json"
  [ -f "$PJ" ] || continue
  git diff --cached --name-only | grep -qx "$PJ" && [ -n "$(git diff --cached -- "$PJ" | grep '"version"')" ] && continue
  python3 - "$PJ" <<'PY'
import json, sys
p = sys.argv[1]; d = json.load(open(p))
a, b, c = (int(x) for x in d["version"].split("."))
d["version"] = f"{a}.{b}.{c + 1}"
open(p, "w").write(json.dumps(d, indent=2) + "\n")
print(f"{d['name']} plugin version -> {d['version']}")
PY
  git add "$PJ"
done
if command -v claude >/dev/null 2>&1; then
  for T in . plugins/*; do
    claude plugin validate "$T" >/tmp/claude-skills-validate.log 2>&1 || { cat /tmp/claude-skills-validate.log; echo "Validation failed for $T, commit stopped."; exit 1; }
  done
fi
exit 0
